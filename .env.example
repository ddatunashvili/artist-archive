# ---------------------------------------------------------------------------
# Artist Archive - environment example
# Copy to .env and fill in. NEVER commit .env or paste real secrets in chat.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Local demo default (SQLite, zero setup):
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./dev.db"

# Later: point at a real SQL server. Set the provider, then run
#   npm run db:provider && npm run db:generate && npm run db:migrate
#
# PostgreSQL:
#   DATABASE_PROVIDER="postgresql"
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/artist_archive?schema=public"
#
# MySQL / MariaDB:
#   DATABASE_PROVIDER="mysql"
#   DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/artist_archive"
#
# SQL Server:
#   DATABASE_PROVIDER="sqlserver"
#   DATABASE_URL="sqlserver://HOST:1433;database=artist_archive;user=USER;password=PASSWORD;encrypt=true"

# --- AI provider -----------------------------------------------------------
# One of: mock | openai | openrouter
# "mock" needs no API key and uses a deterministic rule-based parser,
# so the app works out of the box.
AI_PROVIDER="mock"

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"

# OpenRouter
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# Optional attribution headers used by OpenRouter rankings
OPENROUTER_SITE_URL="http://localhost:3000"
OPENROUTER_APP_NAME="Artist Archive"

# --- App -------------------------------------------------------------------
# Max characters of CV text accepted per extraction request
MAX_CV_CHARS="20000"

# --- Site / SEO -------------------------------------------------------------
# Public origin. Used for canonical URLs, sitemap.xml, robots.txt and
# Open Graph tags. No trailing slash.
APP_URL="http://localhost:3000"

# --- Admin panel ------------------------------------------------------------
# Single operator account for /admin. These are the published demo values:
# the login form pre-fills them so the prototype can be tested in one click.
# CHANGE THEM before putting the archive on a public domain.
ADMIN_EMAIL="admin@aeitos.com"
ADMIN_PASSWORD="aeitos-demo-2026"
# Signs the admin session cookie. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=""

# Keep the published demo account usable alongside a real ADMIN_EMAIL /
# ADMIN_PASSWORD. Defaults to on only while no owner account is configured.
DEMO_ADMIN=""

# Open sign-up at /admin/register. New accounts are always "editor": they can
# import, review, publish and edit, but cannot delete an artist or manage
# accounts. Set "false" to close registration.
ALLOW_REGISTRATION=""
